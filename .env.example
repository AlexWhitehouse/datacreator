# Copy to .env and fill in. .env is git-ignored.

# Requesty inference gateway (OpenAI-compatible). Leave the key blank to disable AI data types.
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1
REQUESTY_MODEL=vertex/claude-haiku-5-5@eu

# Optional
# AI_CONCURRENCY=6            # parallel AI calls during a run
# AI_REASONING_EFFORT=none    # "none" skips hidden reasoning (faster/cheaper); blank = model default
# DATACREATOR_DATA=./data     # where templates, runs and the database live
